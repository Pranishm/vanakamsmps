<?xml version="1.0" encoding="utf-8"?>
<!--
    colors.xml
    Place in: android/app/src/main/res/values/
    All color tokens used by the VANAKAMSMPS home screen widget
-->
<resources>

    <!-- ── BASE ── -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="transparent">#00000000</color>

    <!-- ── ONLINE STATE ── -->
    <color name="online_green">#3DFF8A</color>
    <color name="online_green_sm">#4DFF9A</color>
    <color name="online_green_dim">#6464B48C</color>

    <!-- Label pill text: "SERVER STATUS" -->
    <color name="label_text">#D9C8DCFF</color>

    <!-- Subtitle under server name -->
    <color name="tagline_text">#9996AADC</color>

    <!-- "PLAYERS ONLINE" micro-label -->
    <color name="players_label">#8078A0DC</color>

    <!-- " / 1000" max players text -->
    <color name="player_max_text">#8064B48C</color>

    <!-- Bottom tagline bar text (online) -->
    <color name="tagline_bar_text">#8096C8FF</color>

    <!-- ── OFFLINE STATE ── -->
    <color name="offline_red">#FF4444</color>
    <color name="offline_red_sm">#FF5555</color>
    <color name="offline_red_dim">#66FF4444</color>

    <!-- Subtitle under server name (offline) -->
    <color name="tagline_text_offline">#99966496</color>

    <!-- "LAST SEEN: X AGO" text -->
    <color name="last_seen_text">#99A05050</color>

    <!-- "UNABLE TO CONNECT" info title -->
    <color name="info_title_text">#E6DCA0A0</color>

    <!-- Info description text -->
    <color name="info_desc_text">#99A06464</color>

    <!-- "RETRYING IN 30 SECONDS" text -->
    <color name="retry_text">#CCDCA08C</color>

    <!-- Bottom tagline bar text (offline) -->
    <color name="tagline_bar_text_offline">#80C87878</color>

    <!-- ── BACKGROUNDS (semi-transparent) ── -->
    <!-- Dark overlay panels -->
    <color name="panel_dark">#59000000</color>
    <color name="panel_darker">#73000000</color>

    <!-- Online card base -->
    <color name="card_bg_online_start">#0E1535</color>
    <color name="card_bg_online_mid">#0A0D28</color>
    <color name="card_bg_online_end">#110820</color>

    <!-- Offline card base -->
    <color name="card_bg_offline_start">#1A0707</color>
    <color name="card_bg_offline_mid">#110505</color>
    <color name="card_bg_offline_end">#1A0A08</color>

    <!-- ── BORDERS ── -->
    <color name="border_online">#2850B4FF</color>
    <color name="border_offline">#33DC3232</color>
    <color name="border_panel">#1AFFFFFF</color>
    <color name="border_panel_offline">#26C83C3C</color>
    <color name="border_retry">#33DC3C3C</color>

    <!-- ── BUTTONS ── -->
    <color name="btn_online_start">#22C55E</color>
    <color name="btn_online_end">#16A34A</color>
    <color name="btn_offline_start">#DC2626</color>
    <color name="btn_offline_end">#991B1B</color>

</resources>
