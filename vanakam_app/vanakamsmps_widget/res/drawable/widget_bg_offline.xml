<?xml version="1.0" encoding="utf-8"?>
<!--
    widget_bg_offline.xml
    Place in: android/app/src/main/res/drawable/
    Dark red/crimson gradient background for the OFFLINE card
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base dark red gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1A0707"
                android:centerColor="#110505"
                android:endColor="#1A0A08" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Subtle red border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="#33DC3232" />
            <corners android:radius="20dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</layer-list>
