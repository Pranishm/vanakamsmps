# MongoDB
# Use the exact string from MongoDB Atlas (Connect -> Drivers) and replace <password>.
# IMPORTANT: the host is NOT "cluster.mongodb.net"; it will be something like "cluster0.xxxxx.mongodb.net".
MONGODB_URI=mongodb+srv://pranish:aachi6139@vanakamsmps.ikxp186.mongodb.net/vanakamsmps?retryWrites=true&w=majority&appName=vanakamsmps
# NextAuth
NEXTAUTH_URL=https://vanakam.me
# Generate a strong secret (32+ random bytes). Example (macOS): `openssl rand -base64 32`
NEXTAUTH_SECRET=Y3ImWGmjc5AkyPnR7zM+iMQo+Il4RoTsLGtUsSYLBDg=

NEXTAUTH_TRUST_HOST=true

# Server Info
MINECRAFT_SERVER_IP=marketing-great.gl.joinmc.link
MINECRAFT_SERVER_PORT=25565
MINECRAFT_STAFF_PLAYERS=pranish_M

# Minecraft account linking
# true = online-mode (resolves real UUID from Mojang)
#false = offline-mode (generates offline UUID based on nickname)
MC_ONLINE_MODE=true

# Shop
SHOP_CURRENCY=INR

# Automatic in-game delivery (server plugin)
# Set a strong secret. The plugin must send it via header `x-delivery-key` (or Bearer token).
DELIVERY_API_KEY=change-me
# Optional max retries before marking delivery as FAILED
DELIVERY_MAX_ATTEMPTS=10

# PayPal (Checkout)
# PAYPAL_ENV: sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Stripe (Cards / Apple Pay)
# Create a Stripe account and copy your keys.
# Webhook: configure the endpoint pointing to /api/shop/stripe/webhook
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin Initial Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# Site Info
SITE_NAME=VANAKAMSMPs
SITE_URL=https://vanakam.me

# SEO verification (Google Search Console / Bing Webmaster Tools)
# Google: Settings -> Ownership verification -> HTML tag (content value)
GOOGLE_SITE_VERIFICATION=
# Bing: Site verification meta tag value
BING_SITE_VERIFICATION=

# Email (SMTP) - required for "Forgot password"
# Example: Mailgun/Sendgrid/your SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# On Vercel paste the value WITHOUT quotes.
SMTP_FROM=VANAKAMSMPs <no-reply@vanakam.me>

# Social Links (used in server/components)
DISCORD_URL=https://discord.gg/HN2hprkrKB
YOUTUBE_URL=https://www.youtube.com/@tamilcreators6139

# Public Environment Variables (accessible from the client)
NEXT_PUBLIC_MINECRAFT_SERVER_IP=marketing-great.gl.joinmc.link
NEXT_PUBLIC_MINECRAFT_SERVER_PORT=25565
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/HN2hprkrKB
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@tamilcreators6139

# Uploads (recommended for Vercel production)
# Option A (1 variable):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B (3 variables):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Vercel Blob (uploads on Vercel without Cloudinary)
# Create a Blob Store on Vercel and generate a token with Read/Write permissions.
BLOB_READ_WRITE_TOKEN=

# Chatbot (OpenAI)
# Chatbot (Groq - usually has limited free tier)
GROQ_API_KEY=
# Optional
GROQ_MODEL=ollama-3.1-8b-instant

# Tickets AI (Ollama - local/free)
# Enable automatic responses in ticket chat.
TICKETS_AI_ENABLED=true
# Provider for tickets: ollama | groq | auto
# - ollama: uses local Ollama
# - groq: uses Groq (requires GROQ_API_KEY)
# - auto: tries Ollama and falls back to Groq
TICKETS_AI_PROVIDER=ollama
# Ollama base URL (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model (default: llama3.1)
OLLAMA_MODEL=ollama3.1

# Staff applications form (Home)
# Set to true to enable sending applications to /admin/postulaciones
NEXT_PUBLIC_STAFF_APPLICATIONS_OPEN=false

# Cron (optional)
# If defined, the endpoint /api/cron/services-status will require this secret via header `x-cron-secret`
# or query `?secret=`. If NOT defined and using Vercel Cron, it will be allowed by User-Agent `vercel-cron/1.0`.
CRON_SECRET=

# RCON (optional)
# Used to get list of connected players (for the Admins online widget)
# when the public status does not expose names. Requires RCON enabled on the server.
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
