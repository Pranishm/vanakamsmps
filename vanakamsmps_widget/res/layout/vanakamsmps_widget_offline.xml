<?xml version="1.0" encoding="utf-8"?>
<!--
    VANAKAMSMPS – Offline State Widget Layout
    Place in: android/app/src/main/res/layout/
    Used by: VanakamSMPWidgetProvider via Flutter home_widget package
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_offline"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_offline"
    android:padding="0dp"
    android:clipToPadding="false">

    <!-- ── TOP BAR ── -->
    <LinearLayout
        android:id="@+id/top_bar_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Server Label Pill -->
        <LinearLayout
            android:id="@+id/server_label_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_label_offline"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Red dot -->
            <ImageView
                android:id="@+id/status_dot_off"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot_offline" />

            <TextView
                android:id="@+id/label_server_status_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/server_status_label"
                android:textColor="@color/label_text"
                android:textSize="9sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- OFFLINE pill -->
        <LinearLayout
            android:id="@+id/status_pill_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_status_offline"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/pill_dot_off"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/dot_offline_sm" />

            <TextView
                android:id="@+id/tv_status_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_offline"
                android:textColor="@color/offline_red"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-black" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── SERVER TITLE ── -->
    <TextView
        android:id="@+id/tv_server_title_off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar_off"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:text="@string/server_name"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.01"
        android:maxLines="1" />

    <!-- ── TAGLINE ── -->
    <TextView
        android:id="@+id/tv_tagline_off"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_server_title_off"
        android:layout_marginStart="14dp"
        android:layout_marginTop="1dp"
        android:text="@string/server_tagline"
        android:textColor="@color/tagline_text_offline"
        android:textSize="8sp"
        android:letterSpacing="0.15"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium" />

    <!-- ── OFFLINE STATUS BLOCK ── -->
    <LinearLayout
        android:id="@+id/offline_block"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_tagline_off"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/offline_btn_side"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/offline_block_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- X icon circle -->
        <ImageView
            android:id="@+id/x_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/x_circle_bg"
            android:src="@drawable/ic_x_mark"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_offline_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_offline"
                android:textColor="@color/offline_red"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textAllCaps="true"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tv_last_seen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_seen"
                android:textColor="@color/last_seen_text"
                android:textSize="7sp"
                android:letterSpacing="0.10"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── OFFLINE BUTTON (right side) ── -->
    <TextView
        android:id="@+id/offline_btn_side"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@id/offline_block"
        android:layout_alignBottom="@id/offline_block"
        android:layout_marginEnd="14dp"
        android:background="@drawable/btn_offline"
        android:text="@string/btn_offline"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center" />

    <!-- ── RETRY ROW ── -->
    <LinearLayout
        android:id="@+id/retry_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/offline_block"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/retry_row_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ProgressBar
            android:id="@+id/retry_spinner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/offline_red"
            style="?android:attr/progressBarStyle" />

        <TextView
            android:id="@+id/tv_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry_text"
            android:textColor="@color/retry_text"
            android:textSize="9sp"
            android:letterSpacing="0.06"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>

    <!-- ── BOTTOM TAGLINE BAR ── -->
    <LinearLayout
        android:id="@+id/tagline_bar_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bottom_bar_bg_offline"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#9760;"
            android:textColor="@color/tagline_bar_text_offline"
            android:textSize="10sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tv_offline_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offline_tagline"
            android:textColor="@color/tagline_bar_text_offline"
            android:textSize="8sp"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-bold" />
    </LinearLayout>

</RelativeLayout>
